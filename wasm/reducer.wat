        (block $tuple
        (block $KA
        (block $KK
        (block $L
        (block $CCB
        (block $K4
        (block $K3
        (block $K2
        (block $J
        (block $Z
        (block $U
        (block $O
        (block $R
        (block $P
        (block $CC
        (block $BB
        (block $SS
        (block $Y
        (block $A
        (block $C
        (block $B
        (block $I
        (block $K
        (block $S
          (br_table $S $K $I $B $C $A $Y $SS $BB $CC $P $R $O $U $Z $J $K2 $K3 $K4 $CCB $L $KK $KA $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tuple $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $tagged $exit
