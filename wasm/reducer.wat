        (br_if $exit (i32.le_u (i32.load (global.get $free_addr)) (i32.const 2)))
        (local.set $x (call $arg (local.get $stack) (local.get $sp) (i32.const 0)))
        (local.set $y (call $arg (local.get $stack) (local.get $sp) (i32.const 1)))
        (local.set $z (call $arg (local.get $stack) (local.get $sp) (i32.const 2)))
        (local.set $sp (i32.sub (local.get $sp) (i32.const 3)))
        (local.set $n (i32.load (i32.add (local.get $stack)
          (i32.shl (i32.add (local.get $sp) (i32.const 1)) (i32.const 2)))))
        (i32.store (local.get $n) (call $app (local.get $x) (local.get $z)))
        (i32.store offset=4 (local.get $n) (call $app (local.get $y) (local.get $z)))
        (local.set $slice (i32.sub (local.get $slice) (i32.const 1)))
        (br $top)
        )
