;; Handwritten graph reductions over a fixed-width wasm32 node layout.
;; The standalone build selects eight bytes. The C control uses twelve bytes.
;; Return before GC, scheduling, an unsupported primitive, or stack overflow.
;; The standalone WAT evaluator or C control resumes from the saved stack.
(module
  (import "support" "memory" (memory 0))
  (import "support" "stack" (global $stack_addr i32))
  (import "support" "stack_ptr" (global $sp_addr i32))
  (import "support" "stack_size" (global $stack_size_addr i32))
  (import "support" "glob_slice" (global $slice_addr i32))
  (import "support" "cells" (global $cells_addr i32))
  (import "support" "free_map" (global $map_addr i32))
  (import "support" "next_scan_index" (global $scan_addr i32))
  (import "support" "num_free" (global $free_addr i32))
  (import "support" "num_alloc" (global $alloc_addr i32))

  (import "support" "combB" (global $combB_addr i32))
  (import "support" "combC" (global $combC_addr i32))
  (import "support" "combK" (global $combK_addr i32))
  (import "support" "combK2" (global $combK2_addr i32))
  (import "support" "combK3" (global $combK3_addr i32))
  (import "support" "intTable" (global $ints_addr i32))
  (import "support" "red_bb" (global $red_bb_addr i32))
  (import "support" "red_z" (global $red_z_addr i32))
  (import "support" "red_r" (global $red_r_addr i32))
  (import "support" "red_k2" (global $red_k2_addr i32))
  (import "support" "red_k3" (global $red_k3_addr i32))
  (import "support" "red_k4" (global $red_k4_addr i32))
  (import "support" "red_ccb" (global $red_ccb_addr i32))

  ;; Build-time node stride. Binaryen folds this constant before linking.
  (global $node_bytes i32 (i32.const 12))

  ;; Read an argument from an application on the spine.
  (func $arg (param $stack i32) (param $sp i32) (param $offset i32) (result i32)
    (i32.load offset=4
      (i32.load
        (i32.add (local.get $stack)
          (i32.shl (i32.sub (local.get $sp) (local.get $offset)) (i32.const 2))))))

  ;; Allocate one application. The caller has checked the free-node count.
  ;; This function cannot collect or yield.
  (func $app (param $f i32) (param $a i32) (result i32)
    (local $map i32) (local $index i32) (local $word i32)
    (local $pos i32) (local $n i32)
    (local.set $map (i32.load (global.get $map_addr)))
    (local.set $index
      (i32.shr_u (i32.load (global.get $scan_addr)) (i32.const 5)))
    (block $found
      (loop $scan
        (local.set $word
          (i32.load (i32.add (local.get $map)
            (i32.shl (local.get $index) (i32.const 2)))))
        (br_if $found (local.get $word))
        (local.set $index (i32.add (local.get $index) (i32.const 1)))
        (br $scan)))
    (local.set $pos
      (i32.add (i32.shl (local.get $index) (i32.const 5))
        (i32.ctz (local.get $word))))
    (i32.store
      (i32.add (local.get $map) (i32.shl (local.get $index) (i32.const 2)))
      (i32.and (local.get $word) (i32.sub (local.get $word) (i32.const 1))))
    (i32.store (global.get $scan_addr) (local.get $pos))
    (i32.store (global.get $free_addr)
      (i32.sub (i32.load (global.get $free_addr)) (i32.const 1)))
    (i32.store (global.get $alloc_addr)
      (i32.add (i32.load (global.get $alloc_addr)) (i32.const 1)))
    (local.set $n
      (i32.add (i32.load (global.get $cells_addr))
        (i32.mul (local.get $pos) (global.get $node_bytes))))
    (i32.store (local.get $n) (local.get $f))
    (i32.store offset=4 (local.get $n) (local.get $a))
    (local.get $n))

  (func (export "reduce") (param $n i32) (param $base i32) (result i32)
    (local $stack i32) (local $sp i32) (local $limit i32) (local $slice i32)
