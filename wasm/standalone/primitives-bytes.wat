    (then
      ;; Physical capacity is an allocator detail. Keep the same data address.
      (i32.store offset=8 (local.get $descriptor) (i32.const 0))
      (return (call $pair (local.get $a) (call $value_arg (local.get $args) (i32.const 1))))))
  (if (i32.or (i32.eq (local.get $tag) (global.get $T_BSAPPBYTE))
        (i32.eq (local.get $tag) (global.get $T_BSAPPCHAR)))
    (then
      (local.set $value (call $ival (call $value_arg (local.get $args) (i32.const 1))))
      (if (i32.eq (local.get $tag) (global.get $T_BSAPPBYTE))
        (then (call $bs_append_byte (local.get $descriptor) (local.get $value)))
        (else (call $bs_append_char (local.get $descriptor) (local.get $value))))
      (return (call $pair (call $prim (global.get $T_I))
        (call $value_arg (local.get $args) (i32.const 2))))))
  (local.set $offset (call $ival (call $value_arg (local.get $args) (i32.const 1))))
  (if (i32.ge_u (local.get $offset) (local.get $length))
    (then (call $fail (i32.const 42)) (unreachable)))
  (local.set $buffer (i32.add (i32.load offset=4 (local.get $descriptor)) (local.get $offset)))
  (if (i32.eq (local.get $tag) (global.get $T_BSWRITE))
    (then
      (i32.store8 (local.get $buffer) (call $ival (call $value_arg (local.get $args) (i32.const 2))))
      (return (call $pair (call $prim (global.get $T_I))
        (call $value_arg (local.get $args) (i32.const 3))))))
  (local.set $result (call $int (i32.load8_u (local.get $buffer))))
  (if (result i32) (i32.eq (local.get $tag) (global.get $T_BSREAD))
    (then (call $pair (local.get $result) (call $value_arg (local.get $args) (i32.const 2))))
    (else (local.get $result))))
