    (loop $bytes
      (br_if $prefix_equal (i32.eq (local.get $index) (local.get $limit)))
      (local.set $x (i32.load8_u (i32.add (i32.load offset=4 (local.get $a)) (local.get $index))))
      (local.set $y (i32.load8_u (i32.add (i32.load offset=4 (local.get $b)) (local.get $index))))
