;; Byte strings and foreign pointers share a 16-byte descriptor:
;; {length, data, capacity, finalizerRecord}. Capacity zero means immutable.
;; A finalizer record contains {serviceHandle, originalData}. Substrings share
;; that record and the data allocation. No primitive evaluates or collects.
;; Byte-to-list conversion produces one Cons and a deferred tail per call.
;; Failure codes 42..47 report byte bounds, mutability, UTF-8, size, or handles.

;; Wrap an existing descriptor. Kind 1 denotes a byte string; kind 0 denotes
;; a foreign pointer whose length need not be known.
(func $bs_node (param $descriptor i32) (param $kind i32) (result i32)
  (local $node i32)
  (local.set $node (call $node (global.get $T_FORPTR)))
  (i32.store offset=4 (local.get $node) (i32.or (local.get $descriptor) (local.get $kind)))
  (local.get $node))

