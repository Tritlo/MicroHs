(func $bs_copy_descriptor (param $descriptor i32) (result i32)
  (local $copy i32)
  (local.set $copy (call $blob_alloc (i32.const 16) (i32.const 10)))
  (memory.copy (local.get $copy) (local.get $descriptor) (i32.const 16))
  (local.get $copy))

