  (if (i32.load offset=8 (local.get $descriptor))
    (then (call $fail (i32.const 43)) (unreachable)))
  (if (i32.or (i32.gt_u (local.get $offset) (i32.load (local.get $descriptor)))
        (i32.gt_u (local.get $length)
          (i32.sub (i32.load (local.get $descriptor)) (local.get $offset))))
    (then (call $fail (i32.const 42)) (unreachable)))
  (local.set $copy (call $bs_copy_descriptor (local.get $descriptor)))
  (i32.store (local.get $copy) (local.get $length))
  (i32.store offset=4 (local.get $copy)
    (i32.add (i32.load offset=4 (local.get $descriptor)) (local.get $offset)))
  (call $bs_node (local.get $copy) (i32.const 1)))

